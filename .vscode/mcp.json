{
  "servers": {
    "flint": {
      "type": "stdio",
      "command": "node",
      "args": [".github/skills/setup-illustrator-runtime/scripts/runtime-launcher.mjs", "flint"]
    },
    "replicate": {
      "type": "stdio",
      "command": "node",
      "args": [".github/skills/setup-illustrator-runtime/scripts/runtime-launcher.mjs", "replicate"],
      "env": {
        "REPLICATE_API_TOKEN": "${env:REPLICATE_API_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        ".github/skills/setup-illustrator-runtime/scripts/runtime-launcher.mjs",
        "playwright",
        "--headless",
        "--isolated",
        "--browser",
        "msedge",
        "--allow-unrestricted-file-access"
      ]
    }
  }
}
