# OS / editor / tooling scratch — the plugin repo itself ships only markdown,
# JSON, and prompt files; no node_modules, dist output, or build artefacts.

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code — TRACKED, not ignored. `.vscode/mcp.json` and `.vscode/settings.json`
# are this repo's source of truth for how an adopting workspace is wired up:
# the flint MCP server registration plus the skill/prompt discovery roots.
# Dogfooding them here means a path regression breaks for us before it ships.

# JetBrains
.idea/

# Editor swap files
*.swp
*.swo
*~

# Node (nothing published from this repo — no package.json — but in case
# a contributor scaffolds a local script harness)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local env / secrets — do NOT commit
.env
.env.*
!.env.example

# Local logs / scratch
*.log
.tmp/
tmp/
scratch/

# Alex ACT Edition heir-local paths (not part of this repo's shipping shape;
# guard against accidental commits if a heir clones the repo into a workspace)
.github/skills/local/
.github/prompts/local/
.github/agents/local/
.github/instructions/local/
.github/scripts/local/
